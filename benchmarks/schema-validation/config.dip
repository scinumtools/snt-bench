# Reproducible controls and provenance for the schema-validation comparison.
schema_validation
  execution
    target
      source str = "pinned"
        ?descr "SNT3 source for the in-process DIPL participant: pinned package or local checkout."

    environment
      python_base str = "python3.13"
        ?descr "Interpreter used to create the isolated pinned Python environment."

      local_python_base str = "python3.14"
        ?descr "Interpreter matching the ABI of the local SNT3 Python extension."

    local
      repo str = "../scinumtools3"
        ?descr "SNT3 source checkout used when execution.target.source is local."

    paths
      cases_file str = "benchmarks/schema-validation/cases.json"
        ?descr "Shared fixture corpus containing valid and invalid scientific configuration documents."

      json_schema_file str = "benchmarks/schema-validation/schema.json"
        ?descr "JSON Schema participant's validation schema."

      cue_schema_file str = "benchmarks/schema-validation/schema.cue"
        ?descr "CUE participant's validation schema."

      pkl_schema_file str = "benchmarks/schema-validation/schema.pkl"
        ?descr "Pkl participant's typed validation schema."

      dipl_schema_file str = "benchmarks/schema-validation/schema.dip"
        ?descr "DIPL participant's reusable validation schema."

      output_dir str = "benchmarks/schema-validation/results"
        ?descr "Directory for per-sample CSV, summary CSV, correctness matrix, and figure."

    selection
      participants str[:] = ["dipl", "jsonschema", "cue", "pkl"]
        ?descr "Participants to validate and time; CLI flags can select a subset."

      inprocess_participants str[:] = ["dipl", "jsonschema"]
        ?descr "Python API participants for the in-process comparison; CUE and Pkl use separate runtimes."

      case_ids str[:] = ["*"]
        ?descr "Fixture ID globs to select (valid/<name> or invalid/<check>); all fixtures run by default."

  workload
    snt_command str = "snt"
      ?descr "SNT CLI executable used to validate DIPL projects."

    cue_command str = "cue"
      ?descr "CUE CLI executable on PATH."

    pkl_command str = "pkl"
      ?descr "Pkl CLI executable on PATH."

  timing
    quick
      samples int = 20
        ?descr "Timed batch invocations per participant and fixture class."

      warmups int = 3
        ?descr "Untimed batch invocations before collecting quick samples."

    inprocess
      samples int = 100
        ?descr "Timed in-process batch calls per Python API and fixture class."

      warmups int = 10
        ?descr "Untimed in-process batch calls before collecting samples."

  packages
    scinumtools3
      version str = "0.9.12"
        ?descr "Pinned SNT3 release used by the DIPL Python adapter."
        ?rationale "Release: https://pypi.org/project/scinumtools3/0.9.12/"

      website str = "https://github.com/scinumtools/snt3"
        ?descr "SNT3 project home."

      feature_docs str = "https://scinumtools.github.io/snt3/modules/puq/quantities.html"
        ?descr "Project documentation for PUQ quantities; documentation is not versioned by release."

    jsonschema
      version str = "4.26.0"
        ?descr "Pinned Python JSON Schema validator."
        ?rationale "Release: https://pypi.org/project/jsonschema/4.26.0/"

      website str = "https://github.com/python-jsonschema/jsonschema"
        ?descr "Python jsonschema project source."

      feature_docs str = "https://python-jsonschema.readthedocs.io/en/v4.26.0/"
        ?descr "Documentation for the pinned Python JSON Schema validator."

    cue
      version str = "0.17.1"
        ?descr "Pinned CUE CLI version; install separately and ensure it is on PATH."
        ?rationale "Release: https://github.com/cue-lang/cue/releases/tag/v0.17.1"

      website str = "https://cuelang.org/"
        ?descr "CUE project and official documentation."

      feature_docs str = "https://cuelang.org/docs/concept/how-cue-enables-data-validation/"
        ?descr "Official data validation guide."

    pkl
      version str = "0.32.2"
        ?descr "Pinned Pkl CLI version; install separately and ensure it is on PATH."
        ?rationale "Release: https://github.com/apple/pkl/releases/tag/0.32.2"

      website str = "https://pkl-lang.org/"
        ?descr "Pkl project and official documentation."

      feature_docs str = "https://pkl-lang.org/main/0.32.2/language-reference/index.html"
        ?descr "Language reference for the pinned Pkl version."

    numpy
      version str = "2.5.4"
        ?descr "Pinned NumPy dependency for rendering numeric results."
        ?rationale "Release: https://pypi.org/project/numpy/2.5.4/"

    matplotlib
      version str = "3.11.2"
        ?descr "Pinned Matplotlib dependency used to render the figure."
        ?rationale "Release: https://pypi.org/project/matplotlib/3.11.2/"

  provenance
    json_schema_suite str = "https://github.com/json-schema-org/JSON-Schema-Test-Suite"
      ?descr "Canonical JSON Schema implementation conformance suite; not used as a cross-language timing corpus."

    benchmark_method str = "https://github.com/open-circle/schema-benchmarks"
      ?descr "Reference for separating initialization, validation, and parsing measurements."
